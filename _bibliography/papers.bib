@unpublished{zhu2025agentic,
  title={Agentic Framework for Political Biography Extraction},
  author={Zhu, Yifei and Yang, Songpo and Zhu, Jiangnan and Jiang, Junyan},
  year={2026},
  note={Revise and resubmit, American Journal of Political Science},
  abstract={The production of large-scale political datasets typically demands extracting structured facts from vast piles of unstructured documents or web sources, a task that traditionally relies on expensive human experts and remains prohibitively difficult to automate at scale. We leverage Large Language Models (LLMs) to automate the extraction of multi-dimensional elite biographies. We propose a two-stage Synthesis-Coding framework: an upstream synthesis stage that uses recursive agentic LLMs to search, filter, and curate biographies from heterogeneous web sources, followed by a downstream coding stage that maps curated biography into structured dataframes.},
  arxiv={2603.18010},
  doi={10.48550/arXiv.2603.18010},
  code={https://github.com/yifeifrank/poli_searcher},
  html={https://papers.ssrn.com/abstract=6334258},
  bibtex_show={true},
  selected={false}
}

