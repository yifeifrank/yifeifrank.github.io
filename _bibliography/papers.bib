@unpublished{zhu2025agentic,
  title={Agentic Framework for Political Biography Extraction},
  author={Zhu, Yifei and Yang, Songpo and Zhu, Jiangnan and Jiang, Junyan},
  year={2026},
  note={Working paper},
  abstract={Producing large-scale political datasets typically demands extracting structured facts from numerous unstructured documents or web sources, traditionally relying on expensive human experts and resisting at-scale automation. We leverage large language models (LLMs) to automatically extract multi-dimensional elite biographies, addressing a long-standing bottleneck in political science. We propose a two-stage "Synthesis-Coding" framework for complex extraction tasks: upstream synthesis using recursive agentic LLMs to search, filter, and curate biographies from heterogeneous web sources; then downstream coding-mapping curated biographies into structured dataframes. We validate this framework through three primary results. First, when given curated contexts, LLM coders match or outperform human experts in extraction accuracy. Second, in web environments, the agentic system synthesizes more information from web resources than human collective intelligence (Wikipedia). Finally, directly coding from long, multi-language contexts remains challenging, underscoring the importance of the synthesis stage.},
  html={https://papers.ssrn.com/abstract=6334258},
  bibtex_show={true},
  selected={true}
}

